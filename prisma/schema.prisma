generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Unidade_medida {
  Unidade
  Duzia
  Pacote
  Kilo
  Litro
  Centimetro
}

enum Status {
  Corte
  Costura
  Revisão
  Etiqueta
  Embalagem
}

model dim_cliente {
  cliente_id    Int          @id @default(autoincrement())
  nome          String       @db.VarChar(100)
  cpf_cnpj      String       @unique @db.VarChar(20)
  telefone      String?      @db.VarChar(20)
  email         String       @unique @db.VarChar(100)
  endereco      String?      @db.VarChar(200)
  data_cadastro DateTime?    @default(dbgenerated("CURRENT_DATE")) @db.Date
  fct_pedido    fct_pedido[]
}

model dim_fornecedor {
  fornecedor_id Int           @id @default(autoincrement())
  nome_fantasia String        @db.VarChar(100)
  razao_social  String?       @db.VarChar(150)
  cnpj          String        @unique @db.VarChar(20)
  telefone      String?       @db.VarChar(20)
  email         String        @unique @db.VarChar(100)
  endereco      String?       @db.VarChar(200)
  data_cadastro DateTime?     @default(dbgenerated("CURRENT_DATE")) @db.Date
  dim_insumo    dim_insumo[]
  dim_produto   dim_produto[]
}

model dim_insumo {
  insumo_id      Int                      @id @default(autoincrement())
  nome           String                   @db.VarChar(100)
  descricao      String?                  @db.VarChar(200)
  unidade_medida Unidade_medida
  preco_unitario Decimal?                 @db.Decimal(10, 2)
  fornecedor_id  Int?
  fornecedor     dim_fornecedor?          @relation(fields: [fornecedor_id], references: [fornecedor_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fornecedor")
  map_composicao map_produto_composicao[]
}

model dim_produto {
  produto_id     Int                      @id @default(autoincrement())
  nome           String                   @db.VarChar(100)
  descricao      String?                  @db.VarChar(200)
  preco_unitario Decimal?                 @db.Decimal(10, 2)
  estoque        Int?                     @default(0)
  unidade_medida Unidade_medida
  fornecedor_id  Int?
  fornecedor     dim_fornecedor?          @relation(fields: [fornecedor_id], references: [fornecedor_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fornecedor")
  map_detalhe    map_pedido_detalhe[]
  map_composicao map_produto_composicao[]
}

model fct_pedido {
  pedido_id    Int                  @id @default(autoincrement())
  cliente_id   Int?
  data_pedido  DateTime?            @default(dbgenerated("CURRENT_DATE")) @db.Date
  data_entrega DateTime?            @db.Date
  status       Status
  valor_total  Decimal?             @db.Decimal(12, 2)
  cliente      dim_cliente?         @relation(fields: [cliente_id], references: [cliente_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente")
  map_detalhe  map_pedido_detalhe[]
}

model map_produto_composicao {
  map_id         Int          @id @default(autoincrement())
  produto_id     Int?
  insumo_id      Int?
  quantidade     Decimal      @db.Decimal(10, 2)
  preco_unitario Decimal      @db.Decimal(10, 2)
  insumo         dim_insumo?  @relation(fields: [insumo_id], references: [insumo_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_insumo")
  produto        dim_produto? @relation(fields: [produto_id], references: [produto_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_produto")

  @@unique([produto_id, insumo_id], map: "unico_produto_insumo")
}

model map_pedido_detalhe {
  map_id         Int         @id @default(autoincrement())
  pedido_id      Int
  produto_id     Int
  quantidade     Int         @db.Integer
  preco_unitario Decimal     @db.Decimal(10, 2)
  pedido         fct_pedido  @relation(fields: [pedido_id], references: [pedido_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedido")
  produto        dim_produto @relation(fields: [produto_id], references: [produto_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_produto")

  @@unique([pedido_id, produto_id], map: "unico_pedido_produto")
}
